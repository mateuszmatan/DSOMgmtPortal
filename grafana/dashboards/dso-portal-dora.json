{
  "uid": "dso-portal-dora",
  "title": "DevSecOps pipeline - DORA",
  "description": "DORA metrics and pipeline health of one DevSecOps pipeline. Shipped with the DSO management portal, which embeds its panels.",
  "tags": [
    "devsecops",
    "dora"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "InfluxDB",
        "type": "datasource",
        "query": "influxdb",
        "current": {
          "text": "DORA-metrics",
          "value": "dso-influxdb"
        },
        "hide": 0
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "DORA-metrics",
        "current": {
          "text": "DORA-metrics",
          "value": "DORA-metrics"
        },
        "options": [],
        "hide": 2
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"project\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"project\")",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "allowCustomValue": true,
        "current": {},
        "options": []
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"env\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"env\")",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "allowCustomValue": true,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Deployment frequency",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dora\" and r._field == \"deployment\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true)\n  |> fill(value: 0)\n  |> map(fn: (r) => ({ r with _value: float(v: r._value) }))\n  |> yield(name: \"Deployments per day\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3f6fd8"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0
          },
          "decimals": 0,
          "min": 0,
          "displayName": "Deployments"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Runs whose deployment stage completed green, per day (dora.deployment)."
    },
    {
      "id": 2,
      "title": "Lead time for changes",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dora\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> filter(fn: (r) => r._field == \"deployment\" or r._field == \"lead_time_s\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.deployment == 1 and r.lead_time_s > 0)\n  |> map(fn: (r) => ({ _time: r._time, _value: float(v: r.lead_time_s) }))\n  |> aggregateWindow(every: v.windowPeriod, fn: median, createEmpty: false)\n  |> yield(name: \"Lead time of deployments (median)\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e44ad"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "fillOpacity": 10
          },
          "displayName": "Lead time (median)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Time from the commit under test to the end of the run (dora.lead_time_s)."
    },
    {
      "id": 3,
      "title": "Change failure rate",
      "type": "gauge",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dora\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> filter(fn: (r) => r._field == \"deployment\" or r._field == \"change_failure\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.deployment == 1)\n  |> map(fn: (r) => ({ _time: r._time, _value: float(v: r.change_failure) }))\n  |> mean()\n  |> map(fn: (r) => ({ r with _value: r._value * 100.0 }))\n  |> yield(name: \"Failed deployments %\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "displayName": "Change failure rate",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "description": "Share of runs that did not end SUCCESS (dora.change_failure)."
    },
    {
      "id": 4,
      "title": "Time to restore service",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dora\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> filter(fn: (r) => r._field == \"deployment\" or r._field == \"change_failure\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.deployment == 1)\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({ _time: r._time, _value: int(v: r.change_failure) }))\n  |> difference(nonNegative: false)\n  |> filter(fn: (r) => r._value != 0)\n  |> elapsed(unit: 1s)\n  |> filter(fn: (r) => r._value == -1)\n  |> map(fn: (r) => ({ _time: r._time, _value: float(v: r.elapsed) }))\n  |> yield(name: \"Time to restore after a failed deployment\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e67e22"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always"
          },
          "displayName": "Time to restore"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "On each recovery, how long the pipeline had been failing."
    },
    {
      "id": 6,
      "title": "Build duration",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pipeline_run\" and r._field == \"duration_s\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> group()\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"Build duration\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#16a085"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto"
          },
          "displayName": "Duration"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Average run duration (pipeline_run.duration_s)."
    },
    {
      "id": 5,
      "title": "Run outcome",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pipeline_run\" and r._field == \"build\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> group(columns: [\"result\"])\n  |> aggregateWindow(every: 1d, fn: count, createEmpty: true)\n  |> fill(value: 0)\n  |> yield(name: \"Runs per day by result\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "displayName": "${__field.labels.result}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SUCCESS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "UNSTABLE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FAILURE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ABORTED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "NOT_BUILT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b0b0b0"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Runs per day by Jenkins result (pipeline_run)."
    },
    {
      "id": 7,
      "title": "Slowest stages",
      "type": "bargauge",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"stage_event\" and r._field == \"duration_s\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> filter(fn: (r) => r._value > 0)\n  |> group(columns: [\"stage\"])\n  |> mean()\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 8)\n  |> yield(name: \"Average stage duration\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "description": "Average duration per stage (stage_event.duration_s)."
    },
    {
      "id": 8,
      "title": "Findings above policy",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"security_findings\" and r._field == \"above_policy\")\n  |> filter(fn: (r) => r.project == \"${project}\" and r.env == \"${env}\")\n  |> group(columns: [\"scanner\"])\n  |> aggregateWindow(every: 1d, fn: max, createEmpty: false)\n  |> yield(name: \"Above policy\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 5
          },
          "displayName": "${__field.labels.scanner}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Findings above the library policy per scanner; any value above 0 blocks the release."
    }
  ]
}
